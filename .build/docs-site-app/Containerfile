# .build/docs-site-app/Containerfile (generated -- do not edit)

ARG BASE_IMAGE=quay.io/fedora/fedora:43

FROM scratch AS nodejs
COPY .build/_candy/nodejs.2026.226.1600/ /

FROM scratch AS docs-site
COPY ./ /

FROM ${BASE_IMAGE}

# Bootstrap
RUN --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked \
    printf 'max_parallel_downloads=10\nfastestmirror=True\n' >> /etc/dnf/dnf.conf && \
    dnf install -y --setopt=install_weak_deps=False curl ca-certificates tar gzip && \
    rm -f /etc/yum.repos.d/terra-mesa.repo 2>/dev/null || true && \
    { [ -L /usr/local ] && mkdir -p "$(readlink /usr/local)"; mkdir -p /usr/local/bin; } && \
    ARCH=$(uname -m) && \
    case "$ARCH" in x86_64) ARCH=amd64;; aarch64) ARCH=arm64;; esac && \
    TASK_URL="https://github.com/go-task/task/releases/latest/download/task_linux_${ARCH}.tar.gz" && \
    (curl -fsSL "$TASK_URL" || wget -qO- "$TASK_URL") | tar -xzf - -C /usr/local/bin task

RUN if ! getent passwd 1000 >/dev/null 2>&1; then \
      LOGIN_SHELL=/bin/sh; [ -x /bin/bash ] && LOGIN_SHELL=/bin/bash; \
      if command -v useradd >/dev/null 2>&1; then \
        (getent group 1000 >/dev/null 2>&1 || groupadd -g 1000 user) && \
        useradd -m -u 1000 -g 1000 -s "$LOGIN_SHELL" user; \
      else \
        (getent group 1000 >/dev/null 2>&1 || addgroup -g 1000 user) && \
        adduser -D -h /home/user -u 1000 -G user -s "$LOGIN_SHELL" user; \
      fi; \
    fi

WORKDIR /home/user

# Layer environment variables
ENV NPM_CONFIG_PREFIX="/home/user/.npm-global"
ENV npm_config_cache="/home/user/.cache/npm"
ENV PATH="/home/user/.npm-global/bin:${PATH}"

# Layer: github.com/opencharly/layer-nodejs
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
ENV PNPM_VERSION="10.33.4"
RUN --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked \
    dnf install -y \
      nodejs \
      npm
RUN --mount=type=bind,from=nodejs,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
case "${BUILD_ARCH}" in
  x86_64)  PNPM_ARCH="x64" ;;
  aarch64) PNPM_ARCH="arm64" ;;
  *) echo "Unsupported arch: ${BUILD_ARCH}"; exit 1 ;;
esac
curl -fsSL "https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linux-${PNPM_ARCH}" -o /usr/local/bin/pnpm
chmod 0755 /usr/local/bin/pnpm
OVCMD

# Layer: docs-site
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
ENV DOCS_REF="f1c823b181e8316b20184f4b4d6dd8a495ff1e78"
ENV DOCS_REPO="https://github.com/opencharly/docs.git"
RUN --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked \
    dnf install -y \
      git
RUN --mount=type=bind,from=docs-site,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
rm -rf /srv/docs
git init -q /srv/docs
git -C /srv/docs remote add origin "${DOCS_REPO}"
git -C /srv/docs fetch -q --depth 1 origin "${DOCS_REF}"
git -C /srv/docs checkout -q FETCH_HEAD
# Record what was ACTUALLY fetched, in the same layer as the fetch, so a stale
# cached layer carries a stale sha. Written as a plain file rather than read back
# with git at check time: the check runs as a different uid than this root step and
# git refuses a repo it sees as foreign ("detected dubious ownership"), failing the
# probe for a reason unrelated to the content.
git -C /srv/docs rev-parse HEAD > /srv/docs/.charly-pinned-commit
OVCMD
RUN --mount=type=bind,from=docs-site,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked --mount=type=cache,id=charly-root-.npm,dst=/root/.npm,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
cd /srv/docs
npm ci --no-audit --no-fund
OVCMD
RUN --mount=type=bind,from=docs-site,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-libdnf5,dst=/var/cache/libdnf5,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
cd /srv/docs
npm run build
OVCMD

USER 1000
